PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String (Placeholder only)
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/cognevance_lms?retryWrites=true&w=majority

# JSON Web Token Secret (Placeholder only)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Administrator Secret Key (Placeholder only)
ADMIN_SECRET=your_admin_secret_key_here
